---
interface Props {
  enabled?: boolean;
}

const { enabled = false } = Astro.props;
---

{enabled && (
  <div
    id="cookie-consent-banner"
    class="fixed inset-x-4 bottom-4 z-[80] hidden rounded-lg border border-forest/20 bg-white p-4 shadow-xl md:left-auto md:right-6 md:max-w-md"
    role="dialog"
    aria-live="polite"
    aria-label="Consentement aux cookies"
  >
    <p class="font-title text-xl text-gray-900">Cookies de mesure</p>
    <p class="mt-2 text-sm leading-relaxed text-gray-600">
      Nous utilisons Google Analytics pour comprendre les visites et améliorer le site. Vous pouvez accepter ou refuser ces cookies.
    </p>
    <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:justify-end">
      <button
        type="button"
        id="cookie-consent-reject"
        class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50"
      >
        Refuser
      </button>
      <button
        type="button"
        id="cookie-consent-accept"
        class="rounded-md bg-forest px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-forest/90"
      >
        Accepter
      </button>
    </div>
    <a href="/privacy-policy" class="mt-3 inline-block text-xs font-medium text-forest underline">
      Politique de confidentialité
    </a>
  </div>

  <script>
    const consentKey = 'delco-analytics-consent';
    const banner = document.getElementById('cookie-consent-banner');
    const acceptButton = document.getElementById('cookie-consent-accept');
    const rejectButton = document.getElementById('cookie-consent-reject');

    function updateConsent(consent) {
      localStorage.setItem(consentKey, consent);

      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', {
          analytics_storage: consent === 'granted' ? 'granted' : 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied'
        });
      }

      banner?.classList.add('hidden');
    }

    if (!localStorage.getItem(consentKey)) {
      banner?.classList.remove('hidden');
    }

    window.addEventListener('delco:open-cookie-consent', () => {
      banner?.classList.remove('hidden');
    });

    acceptButton?.addEventListener('click', () => updateConsent('granted'));
    rejectButton?.addEventListener('click', () => updateConsent('denied'));
  </script>
)}
